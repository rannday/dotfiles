{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${USERPROFILE}/.agents/hooks/bin/turn_end.py\" snapshot",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${USERPROFILE}/.agents/hooks/bin/turn_end.py\" format",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${USERPROFILE}/.agents/hooks/bin/turn_end.py\" test",
            "timeout": 600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=grok",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${USERPROFILE}/.agents/hooks/bin/turn_end.py\" format",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${USERPROFILE}/.agents/hooks/bin/turn_end.py\" test",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
