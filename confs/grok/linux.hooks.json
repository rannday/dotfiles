{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(search_replace|write|serena__replace_symbol_body|serena__insert_before_symbol|serena__insert_after_symbol|serena__rename_symbol|serena__safe_delete_symbol|serena__replace_content|serena__replace_in_files)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(github__get_file_contents|github__search_code)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^gk__git_branch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "grep|read_file|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind --client=grok",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "fff__grep|fff__multi_grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(search_replace|write|serena__replace_symbol_body|serena__insert_before_symbol|serena__insert_after_symbol|serena__rename_symbol|serena__safe_delete_symbol|serena__replace_content|serena__replace_in_files)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^gopls__go_(symbol_references|diagnostics)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/turn_end.py\" snapshot",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/turn_end.py\" format",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/turn_end.py\" test",
            "timeout": 600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/turn_end.py\" review",
            "timeout": 300
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=grok",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/tool_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/turn_end.py\" format",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/turn_end.py\" test",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
