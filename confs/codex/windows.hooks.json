{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|apply_patch|read_file|grep|Grep|mcp__(filesystem|git|fetch|fff|github|gopls|serena)__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,sys;sys.path.insert(0,str(pathlib.Path.home()/'.agents/hooks/bin'));runpy.run_path(str(pathlib.Path.home()/'.agents/hooks/bin/codex_hooks.py'),run_name='__main__')\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,sys;sys.path.insert(0,str(pathlib.Path.home()/'.agents/hooks/bin'));runpy.run_path(str(pathlib.Path.home()/'.agents/hooks/bin/codex_hooks.py'),run_name='__main__')\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
