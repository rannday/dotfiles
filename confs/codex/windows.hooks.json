{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,sys;sys.path.insert(0,str(pathlib.Path.home()/'.codex/hooks/bin'));runpy.run_path(str(pathlib.Path.home()/'.codex/hooks/bin/codex_hooks.py'),run_name='__main__')\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|apply_patch|read_file|grep|Grep|mcp__(desktop[-_]commander|fff|gk|github|gopls|serena)__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,sys;sys.path.insert(0,str(pathlib.Path.home()/'.codex/hooks/bin'));runpy.run_path(str(pathlib.Path.home()/'.codex/hooks/bin/codex_hooks.py'),run_name='__main__')\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|mcp__(desktop[-_]commander|fff|gopls|serena)__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,sys;sys.path.insert(0,str(pathlib.Path.home()/'.codex/hooks/bin'));runpy.run_path(str(pathlib.Path.home()/'.codex/hooks/bin/codex_hooks.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,sys;sys.path.insert(0,str(pathlib.Path.home()/'.codex/hooks/bin'));runpy.run_path(str(pathlib.Path.home()/'.codex/hooks/bin/codex_hooks.py'),run_name='__main__')\"",
            "timeout": 1000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,sys;sys.path.insert(0,str(pathlib.Path.home()/'.codex/hooks/bin'));runpy.run_path(str(pathlib.Path.home()/'.codex/hooks/bin/codex_hooks.py'),run_name='__main__')\"",
            "timeout": 750
          }
        ]
      }
    ]
  }
}
