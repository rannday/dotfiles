{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|apply_patch|read_file|grep|Grep|mcp__(desktop[-_]commander|fff|gk|github|gopls|serena)__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/codex_hooks.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__desktop[-_]commander__(start_process|interact_with_process|kill_process)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.agents/hooks/bin/codex_hooks.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
