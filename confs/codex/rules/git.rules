# Safe reads use normal sandbox permissions. No blanket allow bypasses the sandbox.
# Git MCP is preferred in AGENTS.md; native Git fills missing capabilities.
# Strictest matching decision wins: narrow allows cannot override prompts.
# Branch/tag/worktree listings conservatively prompt: prefixes cannot restrict
# trailing arguments. Global options, reordered flags, wrappers, and executable
# paths may miss these rules; native review/sandbox checks remain necessary.
prefix_rule(
    pattern = [["git", "git.exe"], ["add", "rm", "mv", "checkout", "switch", "restore", "commit", "rebase", "merge", "reset", "stash", "fetch", "pull", "push", "clone", "tag", "worktree", "branch", "bisect"]],
    decision = "prompt",
    justification = "Git mutations require review; branch, tag, and worktree listings share these prefixes.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "remote", ["set-url", "add", "remove", "rename", "set-head", "set-branches", "prune", "update"]],
    decision = "prompt",
    justification = "Remote changes require review and must preserve SSH aliases.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "clean"],
    decision = "forbidden",
    justification = "Git clean can delete untracked work.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset discards local work.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "stash", ["drop", "clear"]],
    decision = "forbidden",
    justification = "Deleting saved work is forbidden.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "Force pushes can rewrite remote history.",
)
